# =============================================================================
# ENVIRONMENT VARIABLES — Copy this file to .env and fill in your values
# =============================================================================

# DATABASE CONFIGURATION
DATABASE_URL="postgresql://user:password@localhost:5433/bookstore_db?schema=public"
# Optional overrides. Remote Postgres hosts use SSL automatically unless DATABASE_SSL=false.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=30000

# JWT CONFIGURATION
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
# Access token (JWT) — nên giữ ngắn để bảo mật
JWT_EXPIRES_IN="15m"
# Refresh token (UserSession) — số ngày hết hạn
JWT_REFRESH_EXPIRES_IN_DAYS=7

# REDIS CONFIGURATION
# Dùng cho giỏ hàng (cart), queue email BullMQ và orders
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

# ELASTICSEARCH CONFIGURATION
# Thiếu/hỏng ES thì search tự fallback sang PostgreSQL
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_INDEX="books_v1"

# PAYOS PAYMENT (Cổng thanh toán online chính — VietQR)
# UI hiển thị: COD / Chuyển khoản ngân hàng / Momo / VNPay — 3 lựa chọn online đều tạo mã VietQR qua PayOS
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_RETURN_URL="http://localhost:5173/payment/result"
PAYOS_CANCEL_URL="http://localhost:5173/payment/result"
# Webhook phải khớp URL cấu hình trong dashboard PayOS (deploy: https://<backend>/payment/payos/callback)
PAYOS_WEBHOOK_URL="https://your-ngrok-url.ngrok-free.dev/payment/payos/callback"

# MOMO / VNPAY (LEGACY — code giữ endpoint nhưng UI hiện không dùng trực tiếp)
# MOMO_PARTNER_CODE="your-momo-partner-code"
# MOMO_ACCESS_KEY="your-momo-access-key"
# MOMO_SECRET_KEY="your-momo-secret-key"
# VNPAY_TMN_CODE="your-vnpay-tmn-code"
# VNPAY_HASH_SECRET="your-vnpay-hash-secret"

# APPLICATION CONFIGURATION
PORT=3000
# CORS origin(s) cho frontend. Nhiều origin thì cách nhau bằng dấu phẩy.
# VD: FRONTEND_URL="http://localhost:5173,https://your-app.vercel.app"
# Không khai báo → mặc định "http://localhost:5173,http://localhost:3000"
FRONTEND_URL="http://localhost:5173"
PAYMENT_RESULT_URL="http://localhost:5173/payment/result"
# Secret cho POST /search/reindex-dev (header x-dev-secret). Mặc định "dev-reindex-2026"
DEV_SECRET="dev-reindex-2026"

# DEEPSEEK AI CHATBOT (OPTIONAL)
# Bỏ trống DEEPSEEK_API_KEY → chatbot dùng Local RAG Fallback (tìm sách trong DB, không gọi API ngoài)
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_MODEL="deepseek-chat"
